<?xml version="1.0" ?>

<sdf version="1.9">

  <world name="level3_world">

    <physics name="physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>

    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>

    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>

    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.5 0.1 -1</direction>
    </light>

    <!-- Ground -->

    <model name="ground">
      <static>true</static>

      <link name="ground_link">

        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>

          <material>
            <ambient>0.75 0.75 0.75 1</ambient>
            <diffuse>0.75 0.75 0.75 1</diffuse>
          </material>
        </visual>

      </link>
    </model>

    <!-- Static obstacle 1 -->

    <model name="obstacle_1">
      <static>true</static>
      <pose>-1.7 3 0.75 0 0 0</pose>

      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>2 2 1.5</size></box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box><size>2 2 1.5</size></box>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Static obstacle 2 -->

    <model name="obstacle_2">
      <static>true</static>
      <pose>0 0 0.75 0 0 0</pose>

      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>1.6 1.6 1.5</size></box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box><size>1.6 1.6 1.5</size></box>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Static obstacle 3 -->

    <model name="obstacle_3">
      <static>true</static>
      <pose>3 -3 0.75 0 0 0</pose>

      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>2 2 1.5</size></box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box><size>2 2 1.5</size></box>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Trial markers; the evaluator repositions them before each paired run. -->
    <model name="start_marker">
      <static>true</static><pose>-4 0 0.005 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.4</radius><length>0.01</length></cylinder></geometry><surface><contact><collide_bitmask>0x00</collide_bitmask></contact></surface></collision>
        <visual name="visual"><geometry><cylinder><radius>0.4</radius><length>0.01</length></cylinder></geometry><material><ambient>0 0.8 0.1 1</ambient><diffuse>0 0.8 0.1 1</diffuse></material></visual>
      </link>
    </model>
    <model name="goal_marker">
      <static>true</static><pose>4 0 0.005 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.4</radius><length>0.01</length></cylinder></geometry><surface><contact><collide_bitmask>0x00</collide_bitmask></contact></surface></collision>
        <visual name="visual"><geometry><cylinder><radius>0.4</radius><length>0.01</length></cylinder></geometry><material><ambient>0.85 0.1 0 1</ambient><diffuse>0.85 0.1 0 1</diffuse></material></visual>
      </link>
    </model>

    <!-- 12m x 12m arena walls matching the planner map. -->
    <model name="wall_north"><static>true</static><pose>0 6.05 0.5 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>12.2 0.1 1</size></box></geometry></collision><visual name="visual"><geometry><box><size>12.2 0.1 1</size></box></geometry></visual></link></model>
    <model name="wall_south"><static>true</static><pose>0 -6.05 0.5 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>12.2 0.1 1</size></box></geometry></collision><visual name="visual"><geometry><box><size>12.2 0.1 1</size></box></geometry></visual></link></model>
    <model name="wall_east"><static>true</static><pose>6.05 0 0.5 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.1 12 1</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.1 12 1</size></box></geometry></visual></link></model>
    <model name="wall_west"><static>true</static><pose>-6.05 0 0.5 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.1 12 1</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.1 12 1</size></box></geometry></visual></link></model>

    <!-- Pedestrian 1 -->

    <model name="pedestrian_1">
      <static>true</static>
      <pose>-3 -2 0.85 0 0 0</pose>

      <link name="body">
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.25</radius>
              <length>1.7</length>
            </cylinder>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.25</radius>
              <length>1.7</length>
            </cylinder>
          </geometry>

          <material>
            <ambient>1 0.5 0 1</ambient>
            <diffuse>1 0.5 0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Pedestrian 2 -->

    <model name="pedestrian_2">
      <static>true</static>
      <pose>2 3 0.85 0 0 0</pose>

      <link name="body">
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.25</radius>
              <length>1.7</length>
            </cylinder>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.25</radius>
              <length>1.7</length>
            </cylinder>
          </geometry>

          <material>
            <ambient>1 0.5 0 1</ambient>
            <diffuse>1 0.5 0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Pedestrian 3 -->

    <model name="pedestrian_3">
      <static>true</static>
      <pose>1.5 -4 0.85 0 0 0</pose>

      <link name="body">
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.25</radius>
              <length>1.7</length>
            </cylinder>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.25</radius>
              <length>1.7</length>
            </cylinder>
          </geometry>

          <material>
            <ambient>1 0.5 0 1</ambient>
            <diffuse>1 0.5 0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>

</sdf>
