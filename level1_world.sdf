<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="level1_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground Plane (12m x 12m Arena, plain grey concrete) -->
    <model name="ground_plane">
      <static>true</static>
      <pose>0 0 -0.001 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>12 12 0.002</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>12 12 0.002</size></box>
          </geometry>
          <material>
            <ambient>0.85 0.85 0.85 1</ambient>
            <diffuse>0.85 0.85 0.85 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Five fixed collision-size variants; the evaluator activates one per seeded trial. -->
    <model name="central_obstacle_1">
      <static>true</static>
      <pose>0 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.5 2.0 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.5 2.0 1.0</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material></visual>
      </link>
    </model>
    <model name="central_obstacle_2">
      <static>true</static>
      <pose>32 30 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.75 2.25 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.75 2.25 1.0</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material></visual>
      </link>
    </model>
    <model name="central_obstacle_3">
      <static>true</static>
      <pose>33 30 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2.0 2.0 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>2.0 2.0 1.0</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material></visual>
      </link>
    </model>
    <model name="central_obstacle_4">
      <static>true</static>
      <pose>34 30 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2.25 1.75 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>2.25 1.75 1.0</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material></visual>
      </link>
    </model>
    <model name="central_obstacle_5">
      <static>true</static>
      <pose>35 30 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2.5 2.5 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>2.5 2.5 1.0</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Green start pad, repositioned for each trial. -->
    <model name="start_marker">
      <static>true</static>
      <pose>0 -4.5 0.005 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder><radius>0.40</radius><length>0.01</length></cylinder>
          </geometry>
          <!-- Sensor mask: allow robot to drive over without physics push -->
          <surface>
            <contact><collide_bitmask>0x00</collide_bitmask></contact>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder><radius>0.40</radius><length>0.01</length></cylinder>
          </geometry>
          <material>
            <ambient>0.0 0.8 0.1 1</ambient>
            <diffuse>0.0 0.8 0.1 1</diffuse>
            <specular>0.1 0.3 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Red goal pad, repositioned for each trial. -->
    <model name="goal_marker">
      <static>true</static>
      <pose>0 4.5 0.005 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder><radius>0.40</radius><length>0.01</length></cylinder>
          </geometry>
          <surface>
            <contact><collide_bitmask>0x00</collide_bitmask></contact>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder><radius>0.40</radius><length>0.01</length></cylinder>
          </geometry>
          <material>
            <ambient>0.85 0.1 0.0 1</ambient>
            <diffuse>0.85 0.1 0.0 1</diffuse>
            <specular>0.3 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- 12m x 12m Arena Perimeter Walls (Matching level1_map.pgm boundaries) -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 6.05 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>12.2 0.1 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>12.2 0.1 1.0</size></box></geometry><material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material></visual>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static>
      <pose>0 -6.05 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>12.2 0.1 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>12.2 0.1 1.0</size></box></geometry><material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material></visual>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <pose>6.05 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.1 12.0 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.1 12.0 1.0</size></box></geometry><material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material></visual>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>-6.05 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.1 12.0 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.1 12.0 1.0</size></box></geometry><material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material></visual>
      </link>
    </model>

  </world>
</sdf>
